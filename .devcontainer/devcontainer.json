{
  "name": "software-estimation",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/software-estimation",
  "remoteUser": "vscode",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "FastAPI (software-estimation)",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "APP_ENV": "development",
    "LOG_LEVEL": "DEBUG",
    "LLM_PROVIDER": "openai",
    "LLM_MODEL": "gpt-4o-mini",
    "HOST": "0.0.0.0",
    "PORT": "8080"
  },
  "postCreateCommand": "uv sync --group dev && (test -f .env || cp .env.example .env)",
  "postStartCommand": "uv sync --group dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  }
}
